{
  "name": "letspray",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Let's Pray: a calm prayer list for iPhone, Mac and the web",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build-web.js",
    "ios": "npm run build && npx cap sync ios && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
